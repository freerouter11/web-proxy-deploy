# نمونه‌ی تنظیمات — این فایل را به ‎.env‎ کپی کن و مقدارها را پر کن
# (‎.env‎ در ‎.gitignore‎ است و هرگز نباید commit شود)

# رمز ورود به پروکسی؛ خالی = بدون رمز (اگر عمومی اجرا می‌کنی حتماً قوی بگذار)
PROXY_PASSWORD=

# پورت اجرا (نسخه Node)
PORT=3000

# اجازه‌ی آدرس‌های داخلی/خصوصی (نسخه Node، فقط برای تست محلی)
ALLOW_PRIVATE=false

# مهلت اتصال به سایت مقصد (میلی‌ثانیه)
PROXY_TIMEOUT_MS=30000

# سقف کش درون‌حافظه‌ای بر حسب مگابایت (خالی = خودکار بر اساس رم کانتینر)
CACHE_MB=
