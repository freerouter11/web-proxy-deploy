<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="9"
    android:versionName="4.4"
    android:compileSdkVersion="34"
    android:compileSdkVersionCodename="14"
    package="com.freerouter.webproxy"
    platformBuildVersionCode="34"
    platformBuildVersionName="14">
    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name="com.freerouter.webproxy.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="smallestScreenSize|screenSize|uiMode|screenLayout|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="web-proxy.aiaikoio323.workers.dev"/>
                <data
                    android:scheme="https"
                    android:host="web-proxy-b.aiaikoio323.workers.dev"/>
                <data
                    android:scheme="https"
                    android:host="web-proxy-c.aiaikoio323.workers.dev"/>
                <data
                    android:scheme="https"
                    android:host="web-proxy-d.aiaikoio323.workers.dev"/>
                <data
                    android:scheme="https"
                    android:host="web-proxy-p.pages.dev"/>
            </intent-filter>
        </activity>
        <activity
            android:label="@string/servers_title"
            android:name="com.freerouter.webproxy.ServersActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:label="@string/settings_title"
            android:name="com.freerouter.webproxy.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <provider
            android:name="com.freerouter.webproxy.CamProvider"
            android:exported="false"
            android:authorities="com.freerouter.webproxy.cam"
            android:grantUriPermissions="true"/>
    </application>
</manifest>
