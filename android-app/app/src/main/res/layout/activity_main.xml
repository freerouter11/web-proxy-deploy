<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:background="@color/toolbar_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <ImageButton
            android:id="@+id/btn_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:tint="@color/tb_icon"
            android:contentDescription="@string/nav_back"/>
        <ImageButton
            android:id="@+id/btn_fwd"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_forward"
            android:scaleType="centerInside"
            android:tint="@color/tb_icon"
            android:contentDescription="@string/nav_forward"/>
        <ImageButton
            android:id="@+id/btn_home"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:tint="@color/tb_icon"
            android:contentDescription="@string/nav_home"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chip"
            android:background="@drawable/bg_chip"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <ImageView
                android:id="@+id/chip_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:contentDescription="@string/layer_state"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="11.5sp"
                android:textColor="@color/chip_text"
                android:ellipsize="end"
                android:id="@+id/chip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_servers"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_layers"
            android:scaleType="centerInside"
            android:tint="@color/tb_icon"
            android:contentDescription="@string/manage_layers"/>
        <ImageButton
            android:id="@+id/btn_more"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more"
            android:scaleType="centerInside"
            android:tint="@color/tb_icon"
            android:contentDescription="@string/more"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ProgressBar
            android:layout_gravity="top"
            android:id="@+id/progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#00000000"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/banner_text"
            android:gravity="center"
            android:layout_gravity="top"
            android:id="@+id/offline_banner"
            android:background="@color/banner_offline_bg"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/offline_banner"/>
        <FrameLayout
            android:id="@+id/fullscreen_container"
            android:background="@android:color/black"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</LinearLayout>
